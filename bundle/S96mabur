#!/bin/sh
DAEMON=/usr/bin/maburd
CONF=${MABUR_CONF:-/etc/mabur.toml}
# The image's own default (OpenIPC's read-only squashfs), the copy of it the
# current $CONF was last refreshed from, and the opt-out.
IMAGE_CONF=${MABUR_IMAGE_CONF:-/rom/etc/mabur.toml}
STAMP=${MABUR_CONF_STAMP:-$CONF.image}
KEEP=${MABUR_CONF_KEEP:-/etc/mabur.keep}
BACKUP_DIR=${MABUR_CONF_BACKUP:-/root}
# Clean-slate epoch. A release that must start every drone from the image's
# default bumps CONFIG_EPOCH: the first start of an image whose epoch is not
# the one $EPOCH_FILE recorded replaces $CONF with the image default and
# carries NOTHING over (not the calibration, not the floor) and ignores (and
# removes) $KEEP. The old file is backed up as for a refresh. Later images
# with the same epoch refresh as below. 2026-10-30 = d17 (operator's call:
# every config wiped on that flash).
CONFIG_EPOCH=${MABUR_CONFIG_EPOCH:-2026-10-30}
EPOCH_FILE=${MABUR_CONF_EPOCH:-/etc/mabur.epoch}
PIDFILE=/var/run/mabur-loop.pid
LOGPIDFILE=/var/run/mabur-logwatch.pid
LOG=/tmp/mabur.log
LOG_MAX=$((4 * 1024 * 1024))

loop() {
  while true; do
    # Truncate on every (re)start rather than appending across runs: /tmp is
    # RAM-backed, so an ever-growing log over a long respawn loop can exhaust
    # it. This keeps only the current run's log, which is also what
    # install.sh/README document ("cat /tmp/mabur.log") — without this
    # redirection there was no log at all.
    #
    # The redirect is O_APPEND (>>) with an explicit truncate first, NOT a
    # plain >. Both start the run at an empty file, but only O_APPEND lets
    # logwatch() truncate underneath a running daemon: with a plain >, the
    # daemon's file offset survives the truncate and the next write recreates
    # a sparse file of the old size instead of restarting at zero.
    : > "$LOG"
    "$DAEMON" -c "$CONF" >> "$LOG" 2>&1
    echo "maburd exited ($?) - respawn in 2s" >&2
    sleep 2
  done
}

# Defence in depth for the 45 MB RAM-backed /tmp: cap the log independent of
# what the daemon (or a library it links) decides to print. A chatty line at
# URB rate once filled /tmp in ~30 min, after which every log write failed
# silently and the log froze — losing exactly the tail you would debug from.
# Losing the oldest 4 MB is strictly better than losing the newest everything.
logwatch() {
  while true; do
    sleep 60
    if [ "$(stat -c %s "$LOG" 2>/dev/null || echo 0)" -gt "$LOG_MAX" ]; then
      : > "$LOG"
      echo "mabur: log exceeded $LOG_MAX bytes - truncated" >> "$LOG"
    fi
  done
}

running() { [ -f "$1" ] && kill -0 "$(cat "$1")" 2>/dev/null; }

same() {
  [ -f "$1" ] && [ -f "$2" ] || return 1
  if command -v cmp >/dev/null 2>&1; then cmp -s "$1" "$2"
  else [ "$(md5sum < "$1")" = "$(md5sum < "$2")" ]; fi
}

# New image, new defaults: sysupgrade keeps the overlay, so a $CONF edited
# under an older image (by hand, setch, maburcal) would hide every default
# the new image changed -- and a key it lacks takes the code default, not
# the bundle's. So once per image: an edited $CONF is copied to
# $BACKUP_DIR/mabur.toml.oldN, the image's default replaces it, and what
# belongs to this drone's own radio is carried over: the TX-power
# calibration (maburcal's four [radio] lines) when it is in use, and a
# wide_igi_floor set by hand (the 40 MHz stall fix is per radio unit: one
# 8812EU needs it, another never stalls). Edits made on THIS image stay
# ($STAMP matches the image). touch $KEEP to never refresh.
wipe_config() {
  what="replaced by the image default (clean slate $CONFIG_EPOCH, nothing carried over)"
  if [ -f "$CONF" ] && ! same "$IMAGE_CONF" "$CONF"; then
    n=1
    while [ -e "$BACKUP_DIR/mabur.toml.old$n" ]; do n=$((n + 1)); done
    old="$BACKUP_DIR/mabur.toml.old$n"
    if cp "$CONF" "$old"; then what="$what; yours is $old"
    else what="$what; NO backup (copy to $old failed)"; fi
  fi
  if [ -f "$KEEP" ]; then
    mv "$KEEP" "$BACKUP_DIR/mabur.keep.old" && what="$what; $KEEP removed"
  fi
  cp "$IMAGE_CONF" "$CONF" && cp "$IMAGE_CONF" "$STAMP" && echo "$CONFIG_EPOCH" > "$EPOCH_FILE"
  echo "mabur config: $CONF $what"
  echo "$(date) $CONF $what" >> "$BACKUP_DIR/mabur-config.log"
}

refresh_config() {
  [ -f "$IMAGE_CONF" ] || return 0              # no image copy (bench host): nothing to do
  if [ "$(cat "$EPOCH_FILE" 2>/dev/null)" != "$CONFIG_EPOCH" ]; then
    wipe_config
    return 0
  fi
  if [ ! -f "$CONF" ]; then
    cp "$IMAGE_CONF" "$CONF" && cp "$IMAGE_CONF" "$STAMP"
    echo "mabur config: $CONF was missing, restored the image default"
    return 0
  fi
  if same "$IMAGE_CONF" "$CONF"; then
    same "$IMAGE_CONF" "$STAMP" || cp "$IMAGE_CONF" "$STAMP"
    return 0
  fi
  same "$IMAGE_CONF" "$STAMP" && return 0       # edited on this image: keep
  if [ -f "$KEEP" ]; then
    echo "mabur config: new image, $CONF kept as is ($KEEP is there)"
    return 0
  fi
  n=1
  while [ -e "$BACKUP_DIR/mabur.toml.old$n" ]; do n=$((n + 1)); done
  old="$BACKUP_DIR/mabur.toml.old$n"
  cp "$CONF" "$old" || { echo "mabur config: cannot back up $CONF, kept as is"; return 0; }
  kept=""
  : > "$CONF.carry"
  if grep -q '^[[:space:]]*power_mode[[:space:]]*=[[:space:]]*"offset"' "$old"; then
    grep -E '^[[:space:]]*(power_mode|rate_walls_rel|legacy_wall_rel|wall_margin_db)[[:space:]]*=' "$old" \
      >> "$CONF.carry"
    kept="TX-power calibration"
  fi
  # A set floor: 0 (off) or 1..127. -1 is "the image's default", so the new
  # image decides.
  if grep -qE '^[[:space:]]*wide_igi_floor[[:space:]]*=[[:space:]]*[0-9]' "$old"; then
    grep -E '^[[:space:]]*wide_igi_floor[[:space:]]*=' "$old" | head -1 >> "$CONF.carry"
    kept="${kept:+$kept and }wide_igi_floor"
  fi
  carried=${kept:+ ($kept kept)}
  # Each carried line replaces the first line of the same key in the new file.
  awk 'FILENAME == ARGV[1] { k = $1; sub(/=.*/, "", k); keep[k] = $0; next }
       { k = $1; sub(/=.*/, "", k)
         if ((k in keep) && !(k in done)) { print keep[k]; done[k] = 1; next }
         print }' "$CONF.carry" "$IMAGE_CONF" > "$CONF.new" &&
    mv "$CONF.new" "$CONF" && cp "$IMAGE_CONF" "$STAMP"
  rm -f "$CONF.carry" "$CONF.new"
  echo "mabur config: new image -- $CONF reset to its default$carried; yours is $old"
  echo "$(date) $CONF reset to the image default$carried; old copy $old" >> "$BACKUP_DIR/mabur-config.log"
}

case "$1" in
  start)
    running "$PIDFILE" || { refresh_config; loop & echo $! > "$PIDFILE"; }
    # Checked independently of the respawn loop: a live daemon must not mask a
    # dead logwatch, since an uncapped log is the failure this guards against.
    running "$LOGPIDFILE" || { logwatch & echo $! > "$LOGPIDFILE"; }
    ;;
  stop)
    [ -f "$PIDFILE" ] && kill "$(cat "$PIDFILE")" 2>/dev/null
    rm -f "$PIDFILE"
    [ -f "$LOGPIDFILE" ] && kill "$(cat "$LOGPIDFILE")" 2>/dev/null
    rm -f "$LOGPIDFILE"
    # The PID kill only stops the respawn-loop subshell; the foreground daemon survives without this.
    killall maburd 2>/dev/null || true   # not running is not an error
    ;;
  restart)
    "$0" stop
    sleep 1
    "$0" start
    ;;
  refresh)
    refresh_config
    ;;
  *)
    echo "usage: $0 {start|stop|restart|refresh}"
    exit 1
    ;;
esac
