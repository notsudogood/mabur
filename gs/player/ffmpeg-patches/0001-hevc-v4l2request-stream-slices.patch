From fbe0b5388d47039a720597de6004873b380853b4 Mon Sep 17 00:00:00 2001
From: Gilang <gilankpam@gmail.com>
Date: Mon, 12 Oct 2026 20:17:29 +0700
Subject: [PATCH] hevc, v4l2request: decode a picture slice by slice across
 packets

AV_PKT_FLAG_PARTIAL marks a packet holding part of an access unit. With
the HEVC decoder's stream_slices option set, such a packet opens or
continues a picture and is not ended at the packet's end; its slice is
queued to a slice-based V4L2 request decoder at once, holding the capture
buffer. The frame stays off the output queue until a packet without the
flag ends the picture (a packet with no slice, e.g. an AUD, ends it with
the slices it has; the held capture buffer is then released with the
stateless FLUSH command). Flushing the decoder with a picture open
releases the held buffer the same way.

A frame's per-slice reference lists are sized by the NAL count of the
packet that starts it; a continued picture grows them by each further
packet's NAL count, so its later slices still get reference lists.
---
 libavcodec/hevc/hevcdec.c        | 62 +++++++++++++++++++++++++++-----
 libavcodec/hevc/hevcdec.h        | 13 +++++++
 libavcodec/hevc/refs.c           | 26 ++++++++++++++
 libavcodec/packet.h              |  8 +++++
 libavcodec/v4l2_request.h        |  2 ++
 libavcodec/v4l2_request_decode.c | 18 ++++++++++
 libavcodec/v4l2_request_hevc.c   | 41 ++++++++++++++++++++-
 7 files changed, 160 insertions(+), 10 deletions(-)

diff --git a/libavcodec/hevc/hevcdec.c b/libavcodec/hevc/hevcdec.c
index 4b14a931a2..5b43fa62c5 100644
--- a/libavcodec/hevc/hevcdec.c
+++ b/libavcodec/hevc/hevcdec.c
@@ -3582,14 +3582,20 @@ static int decode_nal_units(HEVCContext *s, const uint8_t *buf, int length)
     int eos_at_start = 1;
     int flags = (H2645_FLAG_IS_NALFF * !!s->is_nalff) | H2645_FLAG_SMALL_PADDING;
 
-    s->cur_frame = s->collocated_ref = NULL;
+    /* A streamed picture continues: keep its frame and slice state. */
+    const int resume = s->stream_slices && s->stream_open;
+
+    if (!resume)
+        s->cur_frame = s->collocated_ref = NULL;
     s->last_eos = s->eos;
     s->eos = 0;
-    s->slice_initialized = 0;
+    if (!resume) {
+        s->slice_initialized = 0;
 
-    for (int i = 0; i < FF_ARRAY_ELEMS(s->layers); i++) {
-        HEVCLayerContext *l = &s->layers[i];
-        l->cur_frame = NULL;
+        for (int i = 0; i < FF_ARRAY_ELEMS(s->layers); i++) {
+            HEVCLayerContext *l = &s->layers[i];
+            l->cur_frame = NULL;
+        }
     }
 
     /* split the input packet into NAL units, so we know the upper bound on the
@@ -3599,7 +3605,22 @@ static int decode_nal_units(HEVCContext *s, const uint8_t *buf, int length)
     if (ret < 0) {
         av_log(s->avctx, AV_LOG_ERROR,
                "Error splitting the input into NAL units.\n");
-        return ret;
+        goto fail;
+    }
+
+    /* The frame's per-slice reference lists were sized by the NAL count of
+     * the packet that started it, an upper bound on its slices only when the
+     * whole picture is in that packet: grow them by this packet's NALs. */
+    if (resume) {
+        for (int i = 0; i < FF_ARRAY_ELEMS(s->layers); i++) {
+            HEVCLayerContext *l = &s->layers[i];
+
+            if (!l->cur_frame)
+                continue;
+            ret = ff_hevc_frame_grow_rpl(l->cur_frame, s->pkt.nb_nals);
+            if (ret < 0)
+                goto fail;
+        }
     }
 
     for (i = 0; i < s->pkt.nb_nals; i++) {
@@ -3633,8 +3654,10 @@ static int decode_nal_units(HEVCContext *s, const uint8_t *buf, int length)
         }
 
         s->rpu_buf = av_buffer_alloc(nal->raw_size - 2);
-        if (!s->rpu_buf)
-            return AVERROR(ENOMEM);
+        if (!s->rpu_buf) {
+            ret = AVERROR(ENOMEM);
+            goto fail;
+        }
         memcpy(s->rpu_buf->data, nal->raw_data + 2, nal->raw_size - 2);
 
         ret = ff_dovi_rpu_parse(&s->dovi_ctx, nal->data + 2, nal->size - 2,
@@ -3663,6 +3686,15 @@ static int decode_nal_units(HEVCContext *s, const uint8_t *buf, int length)
     }
 
 fail:
+    /* Partial packet: more of this picture follows, so it is not ended
+     * here. Any error ends streaming; the picture is then handled as in a
+     * whole-AU packet that failed. */
+    if (s->stream_slices && s->stream_partial && ret >= 0 && s->cur_frame) {
+        s->stream_open = 1;
+        return ret;
+    }
+    s->stream_open = 0;
+
     for (int i = 0; i < FF_ARRAY_ELEMS(s->layers); i++) {
         HEVCLayerContext *l = &s->layers[i];
 
@@ -3723,7 +3755,10 @@ static int hevc_receive_frame(AVCodecContext *avctx, AVFrame *frame)
 
     s->pkt_dts = AV_NOPTS_VALUE;
 
-    if (ff_container_fifo_can_read(s->output_fifo))
+    /* With no reordering the current frame is queued for output when the
+     * picture starts; while a streamed picture is open its capture buffer is
+     * held, and handing the frame out would wait on it (post_process). */
+    if (!s->stream_open && ff_container_fifo_can_read(s->output_fifo))
         goto do_output;
 
     av_packet_unref(avpkt);
@@ -3756,9 +3791,12 @@ static int hevc_receive_frame(AVCodecContext *avctx, AVFrame *frame)
                    old, s->dovi_ctx.cfg.dv_profile);
     }
 
+    s->stream_partial = s->stream_slices && (avpkt->flags & AV_PKT_FLAG_PARTIAL);
     ret    = decode_nal_units(s, avpkt->data, avpkt->size);
     if (ret < 0)
         return ret;
+    if (s->stream_open)
+        return AVERROR(EAGAIN);
 
 do_output:
     if (ff_container_fifo_read(s->output_fifo, frame) >= 0) {
@@ -4036,6 +4074,10 @@ static void hevc_decode_flush(AVCodecContext *avctx)
 
     if (FF_HW_HAS_CB(avctx, flush))
         FF_HW_SIMPLE_CALL(avctx, flush);
+
+    /* After the hwaccel flush, which releases the capture buffer an open
+     * streamed picture holds. */
+    s->stream_open = 0;
 }
 
 #define OFFSET(x) offsetof(HEVCContext, x)
@@ -4046,6 +4088,8 @@ static const AVOption options[] = {
         AV_OPT_TYPE_BOOL, {.i64 = 0}, 0, 1, PAR },
     { "strict-displaywin", "stricly apply default display window size", OFFSET(apply_defdispwin),
         AV_OPT_TYPE_BOOL, {.i64 = 0}, 0, 1, PAR },
+    { "stream_slices", "accept a picture split across packets flagged AV_PKT_FLAG_PARTIAL, one slice each",
+        OFFSET(stream_slices), AV_OPT_TYPE_BOOL, {.i64 = 0}, 0, 1, PAR },
     { "view_ids", "Array of view IDs that should be decoded and output; a single -1 to decode all views",
         .offset = OFFSET(view_ids), .type = AV_OPT_TYPE_INT | AV_OPT_TYPE_FLAG_ARRAY,
         .min = -1, .max = INT_MAX, .flags = PAR },
diff --git a/libavcodec/hevc/hevcdec.h b/libavcodec/hevc/hevcdec.h
index 6ba2ca3887..3bf968c858 100644
--- a/libavcodec/hevc/hevcdec.h
+++ b/libavcodec/hevc/hevcdec.h
@@ -554,6 +554,12 @@ typedef struct HEVCContext {
     int is_nalff;           ///< this flag is != 0 if bitstream is encapsulated
                             ///< as a format defined in 14496-15
     int apply_defdispwin;
+    /* Streamed decode (AV_PKT_FLAG_PARTIAL): option, a picture continued
+     * across packets, and whether the packet being decoded is partial (read
+     * by the hwaccel to queue its slice at once). */
+    int stream_slices;
+    int stream_open;
+    int stream_partial;
 
     // multi-layer AVOptions
     int         *view_ids;
@@ -599,6 +605,13 @@ int ff_hevc_frame_rps(HEVCContext *s, HEVCLayerContext *l);
  */
 int ff_hevc_slice_rpl(HEVCContext *s);
 
+/**
+ * Make room for nb_extra more slices in a frame whose per-slice reference
+ * lists were sized for the packet that started it (a picture continued in
+ * later packets).
+ */
+int ff_hevc_frame_grow_rpl(HEVCFrame *frame, int nb_extra);
+
 void ff_hevc_save_states(HEVCLocalContext *lc, const HEVCPPS *pps,
                          int ctb_addr_ts);
 int ff_hevc_cabac_init(HEVCLocalContext *lc, const HEVCPPS *pps,
diff --git a/libavcodec/hevc/refs.c b/libavcodec/hevc/refs.c
index 6ba667e9f5..2197dbe72d 100644
--- a/libavcodec/hevc/refs.c
+++ b/libavcodec/hevc/refs.c
@@ -299,6 +299,32 @@ static int init_slice_rpl(HEVCContext *s)
     return 0;
 }
 
+int ff_hevc_frame_grow_rpl(HEVCFrame *frame, int nb_extra)
+{
+    const int nb = frame->nb_rpl_elems + nb_extra;
+    RefPicListTab *rpl;
+
+    if (nb_extra <= 0)
+        return 0;
+
+    rpl = ff_refstruct_allocz(nb * sizeof(*rpl));
+    if (!rpl)
+        return AVERROR(ENOMEM);
+    memcpy(rpl, frame->rpl, frame->nb_rpl_elems * sizeof(*rpl));
+
+    /* rpl_tab and refPicList point into the old array: move them over. */
+    for (int i = 0; i < frame->ctb_count; i++)
+        frame->rpl_tab[i] = rpl + (frame->rpl_tab[i] - frame->rpl);
+    if (frame->refPicList)
+        frame->refPicList = (RefPicList *)(rpl +
+            ((RefPicListTab *)frame->refPicList - frame->rpl));
+
+    ff_refstruct_unref(&frame->rpl);
+    frame->rpl          = rpl;
+    frame->nb_rpl_elems = nb;
+    return 0;
+}
+
 int ff_hevc_slice_rpl(HEVCContext *s)
 {
     SliceHeader *sh = &s->sh;
diff --git a/libavcodec/packet.h b/libavcodec/packet.h
index 0a28010542..dd3218da1b 100644
--- a/libavcodec/packet.h
+++ b/libavcodec/packet.h
@@ -612,6 +612,14 @@ typedef struct AVPacketList {
  */
 #define AV_PKT_FLAG_DISPOSABLE 0x0010
 
+/**
+ * The packet carries part of an access unit and more of the same picture
+ * follows in later packets. Only decoders that support it look at this flag
+ * (HEVC with the "stream_slices" option); the packet that completes the
+ * picture is sent without it.
+ */
+#define AV_PKT_FLAG_PARTIAL    0x8000
+
 enum AVSideDataParamChangeFlags {
     AV_SIDE_DATA_PARAM_CHANGE_SAMPLE_RATE    = 0x0004,
     AV_SIDE_DATA_PARAM_CHANGE_DIMENSIONS     = 0x0008,
diff --git a/libavcodec/v4l2_request.h b/libavcodec/v4l2_request.h
index 62248feb48..79768a00df 100644
--- a/libavcodec/v4l2_request.h
+++ b/libavcodec/v4l2_request.h
@@ -104,4 +104,6 @@ int ff_v4l2_request_start_frame(AVCodecContext *avctx,
 
 void ff_v4l2_request_flush(AVCodecContext *avctx);
 
+int ff_v4l2_request_flush_held_capture(AVCodecContext *avctx);
+
 #endif /* AVCODEC_V4L2_REQUEST_H */
diff --git a/libavcodec/v4l2_request_decode.c b/libavcodec/v4l2_request_decode.c
index 8e7e241e36..4ced92bc71 100644
--- a/libavcodec/v4l2_request_decode.c
+++ b/libavcodec/v4l2_request_decode.c
@@ -457,3 +457,21 @@ void ff_v4l2_request_flush(AVCodecContext *avctx)
 
     ff_mutex_unlock(&ctx->mutex);
 }
+
+/*
+ * Release a capture buffer the decoder holds for more slices that will not
+ * come (a streamed picture ended early): the stateless FLUSH command returns
+ * it once the decode already queued completes.
+ */
+int ff_v4l2_request_flush_held_capture(AVCodecContext *avctx)
+{
+    V4L2RequestContext *ctx = v4l2_request_context(avctx);
+    struct v4l2_decoder_cmd cmd = { .cmd = V4L2_DEC_CMD_FLUSH };
+
+    if (ioctl(ctx->video_fd, VIDIOC_DECODER_CMD, &cmd) < 0) {
+        av_log(ctx, AV_LOG_ERROR, "Failed to flush held capture buffer: %s (%d)\n",
+               strerror(errno), errno);
+        return AVERROR(errno);
+    }
+    return 0;
+}
diff --git a/libavcodec/v4l2_request_hevc.c b/libavcodec/v4l2_request_hevc.c
index 9fabe468b7..716ef18217 100644
--- a/libavcodec/v4l2_request_hevc.c
+++ b/libavcodec/v4l2_request_hevc.c
@@ -618,14 +618,53 @@ static int v4l2_request_hevc_decode_slice(AVCodecContext *avctx,
         controls->frame_slice_params[slice].bit_size = (size + extra_size) * 8;
 
     controls->num_slice_params++;
+
+    /*
+     * Streamed picture: this packet's slice goes to the decoder now, holding
+     * the capture buffer for the slices still to come, instead of waiting
+     * for the next slice to learn whether this one was the last.
+     */
+    if (h->stream_partial &&
+        ctx->decode_mode == V4L2_STATELESS_HEVC_DECODE_MODE_SLICE_BASED) {
+        ret = v4l2_request_hevc_queue_decode(avctx, false);
+        if (ret)
+            return ret;
+
+        ff_v4l2_request_reset_picture(avctx, &controls->pic);
+        controls->num_slice_params = 0;
+        controls->num_entry_point_offsets = 0;
+        controls->first_slice = false;
+    }
+
     return 0;
 }
 
 static int v4l2_request_hevc_end_frame(AVCodecContext *avctx)
 {
+    const HEVCContext *h = avctx->priv_data;
+    V4L2RequestControlsHEVC *controls = h->cur_frame->hwaccel_picture_private;
+
+    /*
+     * A streamed picture ended early: every slice already went out holding
+     * the capture buffer and none is pending, so release the buffer.
+     */
+    if (h->stream_slices && !controls->first_slice && !controls->num_slice_params)
+        return ff_v4l2_request_flush_held_capture(avctx);
+
     return v4l2_request_hevc_queue_decode(avctx, true);
 }
 
+static void v4l2_request_hevc_flush(AVCodecContext *avctx)
+{
+    const HEVCContext *h = avctx->priv_data;
+
+    /* A streamed picture is dropped open: release the capture buffer it holds. */
+    if (h->stream_open)
+        ff_v4l2_request_flush_held_capture(avctx);
+
+    ff_v4l2_request_flush(avctx);
+}
+
 static void v4l2_request_hevc_free_frame_priv(FFRefStructOpaque hwctx, void *data)
 {
     V4L2RequestControlsHEVC *controls = data;
@@ -735,7 +774,7 @@ const FFHWAccel ff_hevc_v4l2request_hwaccel = {
     .start_frame        = v4l2_request_hevc_start_frame,
     .decode_slice       = v4l2_request_hevc_decode_slice,
     .end_frame          = v4l2_request_hevc_end_frame,
-    .flush              = ff_v4l2_request_flush,
+    .flush              = v4l2_request_hevc_flush,
     .free_frame_priv    = v4l2_request_hevc_free_frame_priv,
     .frame_priv_data_size = sizeof(V4L2RequestControlsHEVC),
     .init               = v4l2_request_hevc_init,
